# Builder Prime API connection (server-side only — never ship the key to the browser).
# Subdomain is the first part of your Builder Prime login URL,
# e.g. "johnsfloors" from johnsfloors.builderprime.com
BUILDER_PRIME_SUBDOMAIN=

# Open API key generated in Builder Prime under Admin > Integrations > Open API.
# For v1 (read-only weekly report + project view) it only needs the projects.read scope.
BUILDER_PRIME_API_KEY=

# Optional: restrict the weekly report / project list to a single production manager.
# Set to the manager's Builder Prime employee id to only see their projects (open question §8.4).
# Leave blank to include all projects.
PRODUCTION_MANAGER_ID=

# Reporting week start day. 0 = Sunday (default per spec assumption), 1 = Monday, etc. (open question §8.2)
REPORTING_WEEK_START_DAY=0

# Multiplier applied to raw labor to get Actual Labor (spreadsheet used x1.2).
LABOR_MULTIPLIER=1.2

# HTTP port for the app.
PORT=3000

# Directory where weekly reports are persisted (used for QTD rollups).
DATA_DIR=./data

# When BUILDER_PRIME_API_KEY is empty, the app serves deterministic sample data so the
# UI and math can be exercised without live credentials. Set to "false" to disable.
ALLOW_SAMPLE_DATA=true
