# Builder Prime API connection (server-side only — never ship the key to the browser).
# Subdomain is the first part of your Builder Prime login URL,
# e.g. "johnsfloors" from johnsfloors.builderprime.com
BUILDER_PRIME_SUBDOMAIN=

# Open API key generated in Builder Prime under Admin > Integrations > Open API.
# For v1 (read-only weekly report + project view) it only needs the projects.read scope.
BUILDER_PRIME_API_KEY=

# Optional: restrict the weekly report / project list to a single production manager.
# Set to the manager's Builder Prime employee id to only see their projects (open question §8.4).
# Leave blank to include all projects.
PRODUCTION_MANAGER_ID=

# Reporting week start day. 0 = Sunday (default per spec assumption), 1 = Monday, etc. (open question §8.2)
REPORTING_WEEK_START_DAY=0

# Multiplier applied to raw labor to get Actual Labor (spreadsheet used x1.2).
LABOR_MULTIPLIER=1.2

# HTTP port for the app.
PORT=3000

# Directory where weekly reports are persisted (used for QTD rollups).
# Used only when durable KV storage (below) is NOT configured.
DATA_DIR=./data

# --- Durable storage (REQUIRED for multi-user use on Vercel) ---
# Preferred: Neon Postgres. Create a database at neon.tech (or via Vercel's
# Neon integration, which injects DATABASE_URL automatically) and paste the
# connection string here. Tables are created automatically on first use.
DATABASE_URL=
# Alternative names also accepted: NEON_DATABASE_URL / POSTGRES_URL.

# Fallback: Redis (Vercel KV / Upstash) — used only when DATABASE_URL is unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# When BUILDER_PRIME_API_KEY is empty, the app serves deterministic sample data so the
# UI and math can be exercised without live credentials. Set to "false" to disable.
ALLOW_SAMPLE_DATA=true

# --- Weekly Schedule: Builder Prime custom-field names ---
# The schedule reads SQFT, color, project type, and job number from BP custom fields.
# Provide comma-separated alternate labels to match your Builder Prime setup.
BP_FIELD_SQFT=SQFT,Square Footage,Sq Ft
BP_FIELD_COLOR=Flake Color,Flake/Rubber Color,Color
BP_FIELD_PROJECT_TYPE=Project Type,Job Type,Type
BP_FIELD_JOB_NUMBER=Job Number,Job #,Job No
BP_FIELD_CREW=Crew,Team,Trailer

# --- Weekly Schedule: material coverage rates ---
# Flake / concrete coating:
#   Flake: SQFT x 0.15 = pounds, packed in 40 lb boxes.
#   Polyurea basecoat (grey/tan): 1 total gallon covers 200 sqft, mixed 2 parts A : 1 part B.
#   Polyaspartic topcoat: 1 total gallon covers 130 sqft, equal parts A and B.
FLAKE_LBS_PER_SQFT=0.15
FLAKE_BOX_LBS=40
POLYUREA_SQFT_PER_GALLON=200
POLYUREA_PARTS_A=2
POLYUREA_PARTS_B=1
POLYASPARTIC_SQFT_PER_GALLON=130

# Rubber coating:
#   30 sqft per 50 lb bag of rubber; 160 sqft per 5-gal binder kit;
#   700 sqft per 5-gal primer kit (primer = 3.5 gal binder + 1.5 gal alcohol spirits).
RUBBER_SQFT_PER_BAG=30
RUBBER_SQFT_PER_BINDER_BUCKET=160
RUBBER_SQFT_PER_PRIMER_BUCKET=700
